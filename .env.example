# คัดลอกเป็น .env.local แล้วกรอกค่าจริง (ห้าม commit .env.local)

# 1 = ใช้ข้อมูลตัวอย่าง, 0 = อ่านจาก Oracle PROMIS
USE_MOCK=1

# บัญชี Oracle ที่มีสิทธิ์ SELECT อย่างเดียว
ORACLE_USER=
ORACLE_PASSWORD=
# รูปแบบ host:port/service_name เช่น 10.0.0.10:1521/PROMIS
ORACLE_CONNECT_STRING=
# schema ที่เก็บตาราง PROMIS
ORACLE_SCHEMA=PROMIS

# (ไม่บังคับ) โฟลเดอร์ Oracle Instant Client เพื่อใช้ Thick mode
# ต้องใช้เมื่อ Oracle เก่ากว่า 12.1 หรือภาษาไทยแสดงผิดใน Thin mode
ORACLE_CLIENT_DIR=

# Auth0: ต้องล็อกอินด้วยอีเมล @sru.ac.th จึงจะเห็นเบอร์โทร (ตารางยังเปิดดูได้โดยไม่ต้องล็อกอิน)
# ค่าจาก Auth0 Dashboard → Applications → (Regular Web Application) → Settings
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# คีย์เข้ารหัส session cookie สร้างด้วย: openssl rand -hex 32
AUTH0_SECRET=
# URL ของเว็บนี้ (ไม่มี / ท้าย) เช่น http://localhost:3000 หรือ https://<domain>
APP_BASE_URL=http://localhost:3000
