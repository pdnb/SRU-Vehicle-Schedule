# คัดลอกเป็น .env.local แล้วกรอกค่าจริง (ห้าม commit .env.local)

# 1 = ใช้ข้อมูลตัวอย่าง, 0 = อ่านจาก Oracle PROMIS
USE_MOCK=1

# บัญชี Oracle ที่มีสิทธิ์ SELECT อย่างเดียว
ORACLE_USER=
ORACLE_PASSWORD=
# รูปแบบ host:port/service_name เช่น 10.0.0.10:1521/PROMIS
ORACLE_CONNECT_STRING=
# schema ที่เก็บตาราง PROMIS
ORACLE_SCHEMA=PROMIS

# (ไม่บังคับ) โฟลเดอร์ Oracle Instant Client เพื่อใช้ Thick mode
# ต้องใช้เมื่อ Oracle เก่ากว่า 12.1 หรือภาษาไทยแสดงผิดใน Thin mode
ORACLE_CLIENT_DIR=
